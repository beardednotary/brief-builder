# Copy to .env and fill in. EXPO_PUBLIC_ values are bundled into the app,
# so never put a secret (like an Anthropic key) in this file.
EXPO_PUBLIC_PROXY_URL=https://briefbuilder-proxy.YOUR-SUBDOMAIN.workers.dev

# RevenueCat public SDK keys (Project settings > API keys). These are meant
# to ship in the app. The RevenueCat SECRET key belongs only in the Worker.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_...
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_...
