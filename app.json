{
  "expo": {
    "name": "BriefBuilder",
    "slug": "BriefBuilder",
    "scheme": "briefbuilder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#011D58"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dahvio.briefbuilder",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.dahvio.briefbuilder",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#011D58"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-notifications"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2e9ee1c7-ccd2-472f-9895-fcf5b0eeecf5"
      }
    }
  }
}
